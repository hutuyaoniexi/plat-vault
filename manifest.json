{
  "manifest_version": 3,
  "name": "PlatVault",
  "version": "0.1.1",
  "description": "识别 Warframe 仓库截图并查询物品白金价格。",
  "permissions": ["storage"],
  "host_permissions": ["https://api.warframe.market/*", "https://warframe.market/static/assets/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {},
  "background": { "service_worker": "background.js" }
}
